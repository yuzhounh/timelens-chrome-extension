{
  "firestore": { "database": "(default)", "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "site": "timelens-chrome-extension",
    "public": "firebase-hosting",
    "ignore": ["**/.*", "**/node_modules/**"],
    "headers": [{"source":"**", "headers":[{"key":"Cache-Control","value":"no-store"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"no-referrer"}]}]
  }
}
