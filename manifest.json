{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.1",
  "minimum_chrome_version": "116",
  "key": "",
  "description": "__MSG_extDescription__",
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://timelens-chrome-extension.firebaseapp.com"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/timer-16.png",
      "32": "icons/timer-32.png",
      "48": "icons/timer-48.png",
      "128": "icons/timer-128.png"
    }
  },
  "icons": {
    "16": "icons/timer-16.png",
    "32": "icons/timer-32.png",
    "48": "icons/timer-48.png",
    "128": "icons/timer-128.png"
  },
  "options_page": "dashboard.html",
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandOpenDashboard__"
    }
  }
}
