{
  "manifest_version": 3,
  "name": "时光镜 · 网站访问统计",
  "version": "1.2.9",
  "description": "统计有效网站访问时间，提供可视化、数据导入导出与周期报告邮件备份。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "时光镜",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/timer-16.png",
      "32": "icons/timer-32.png",
      "48": "icons/timer-48.png",
      "128": "icons/timer-128.png"
    }
  },
  "icons": {
    "16": "icons/timer-16.png",
    "32": "icons/timer-32.png",
    "48": "icons/timer-48.png",
    "128": "icons/timer-128.png"
  },
  "options_page": "dashboard.html",
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开统计仪表盘"
    }
  }
}
